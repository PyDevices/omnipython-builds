# Ai-Thinker ESP32-Audio-Kit (ESP32-A1S module): flash and PSRAM at 80 MHz.
# On a classic ESP32 they share one bus with the code the Bluetooth stack runs
# from, and at the default 40 MHz a program busy in PSRAM (redrawing, decoding
# a cover) held it long enough to lose a call's microphone audio: 8 or 9
# dropouts in 15 s of tone, against none in 13 calls at 80 MHz.
# The flash clock is set in the bootloader, so write it with the app.
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=n
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_SPEED_40M=n

# The CPU at 240 MHz, the chip's rated clock, where upstream's default is 160.
# A 48 kHz synth with a reverb on it (soundmodule's default) needs about 5 ms
# of each 5.3 ms block at 160 MHz and clicks; at 240 it needs about 3.5 ms.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=n
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# Logs, not features: Bluedroid's trace strings and every IDF log under ERROR
# come out, which is about 220 KB of the image. Errors still print.
CONFIG_BT_STACK_NO_LOG=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=n
CONFIG_LOG_MAXIMUM_LEVEL_ERROR=y

# No Ethernet MAC: its RMII pins are fixed (RXD0 IO25, RXD1 IO26, CRS_DV IO27,
# the reference clock on IO0), and on this board they are the codec's LRCK,
# DOUT, BCLK and MCLK, so an RMII PHY can't be wired. network.LAN still drives
# SPI Ethernet chips (W5500, DM9051, KSZ8851SNL) on the header.
CONFIG_ETH_USE_ESP32_EMAC=n

# Internal RAM for Bluetooth audio and the network at once. A classic ESP32
# has about 180 KB of it after boot; Wi-Fi took 48 KB, Bluedroid 44 KB, the
# audio pump 29 KB and Bluetooth Receiver's spectrum meter 38 KB, so with a
# phone or computer streaming, a 24 KB thread stack couldn't be had (`can't
# create thread`) and the page's sockets couldn't send (EAGAIN).
#
# Wi-Fi's and lwIP's buffers come from PSRAM first, as on the S3 and S31, and
# every malloc() over 512 bytes does too (the port's threshold is 8 KB): code
# that needs internal or DMA memory asks for it by its caps and still gets it.
# The meter's FFT buffers (2 to 6 KB each) were the largest of those. Both
# together leave about 55 KB free with a stream playing and Wi-Fi joined,
# where there were 5.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
