# The L2 cache at 256 KB, not ESP-IDF's default 128 KB.
#
# The program and the heap live in PSRAM, so everything either core runs or
# touches comes through this one cache. Draw a megabyte into the framebuffer
# on the interpreter's core and the audio render's own code and data are
# pushed out of it; the render then waits on PSRAM to get them back. Nothing
# preempts it: it holds its core the whole time and simply runs slower.
#
# On the Touch-LCD-4B, Synth Station playing with the 720x720 screen redrawn
# whole every 20 ms: at 128 KB the render's worst block took 143 to 216 % of
# the time it has, and the speaker ran out of sound in five 60 s runs of six
# (5 to 8 ms each time). At 256 KB it ran out in none of six, the worst block
# took 118 to 149 %, and the screen redrew 4.2 times a second, not 3.8.
#
# The cache is taken from internal RAM: 131 KB of it, leaving 143 KB free
# with Home open where there were 276 KB. This variant can pay that. The
# DEV-KIT image can't (123 KB free with Home open at 128 KB), so it is set
# here and not for every ESP32-P4.
CONFIG_CACHE_L2_CACHE_256KB=y

# esp_hosted's task stacks in PSRAM.
#
# On a P4 before revision 3, the internal RAM above 0x4ff3afc0 holds the
# startup stacks, and ESP-IDF adds it to the heap only once main_task runs.
# Until then the heap is what IRAM, .data and .bss leave of the low 236 KB,
# plus RTC RAM and TCM: about 105 KB with every module built in. esp_hosted
# starts the C6 link from a constructor, before the scheduler, and takes
# about 80 KB of that: 55 KB of buffer pools and five 5 KB task stacks. The
# main, idle and timer tasks then can't be created, and the board resets
# every 10 s. With the stacks in PSRAM, 25 KB of it stays free.
#
# The pools can't follow: MALLOC_CAP_DMA isn't granted to PSRAM by ESP-IDF
# 5.5's heap, so ESP_HOSTED_MEMPOOL_PREFER_SPIRAM falls back to internal RAM.
CONFIG_ESP_HOSTED_DFLT_TASK_FROM_SPIRAM=y
