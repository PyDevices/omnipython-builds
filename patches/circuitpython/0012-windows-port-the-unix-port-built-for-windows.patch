+SRC_CXX := $(filter-out coveragecpp.cpp,$(SRC_CXX))
+
+FROZEN_MANIFEST = ../unix/variants/coverage/manifest.py
+
+
+# lib/mp3 takes its portable C, not Visual C++'s inline assembly (see ../../mp3_portable.h).
+$(BUILD)/lib/mp3/src/%.o: CFLAGS += -include mp3_portable.h
