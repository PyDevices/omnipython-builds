     o->handle = mod;
diff --git a/ports/windows/Makefile b/ports/windows/Makefile
new file mode 100644
index 0000000..d7c3339
--- /dev/null
+++ b/ports/windows/Makefile
@@ -0,0 +1,208 @@
+# CIRCUITPY-CHANGE: CircuitPython's unix port, built for Windows with MinGW.
+# MicroPython's windows port, which reuses the unix port's main.c, input.c and
+# gccollect.c, with the CircuitPython pieces the unix port's Makefile adds.
+
+# Select the variant to build for:
+ifdef VARIANT_DIR
+# Custom variant path - remove trailing slash and get the final component of
+# the path as the variant name.
+VARIANT ?= $(notdir $(VARIANT_DIR:/=))
+else
+# CIRCUITPY-CHANGE: the unix port's default is coverage, and so is this one's.
+VARIANT ?= coverage
+VARIANT_DIR ?= variants/$(VARIANT)
+endif
+
+ifeq ($(wildcard $(VARIANT_DIR)/.),)
+$(error Invalid VARIANT specified: $(VARIANT_DIR))
+endif
+
+# If the build directory is not given, make it reflect the variant name.
+BUILD ?= build-$(VARIANT)
+
+include ../../py/mkenv.mk
+-include mpconfigport.mk
+include $(VARIANT_DIR)/mpconfigvariant.mk
+
+FROZEN_MANIFEST ?= variants/manifest.py
+
+# Define main target
+# CIRCUITPY-CHANGE: circuitpython.exe
+PROG ?= circuitpython
+
+# qstr definitions (must come before including py.mk)
+QSTR_DEFS += ../unix/qstrdefsport.h
+QSTR_GLOBAL_DEPENDENCIES += $(VARIANT_DIR)/mpconfigvariant.h
+
+# Enable building 32-bit code on 64-bit hosts.
+ifeq ($(MICROPY_FORCE_32BIT),1)
+CC += -m32
+CXX += -m32
+LD += -m32
+endif
+
+# include py core make definitions
+include $(TOP)/py/py.mk
+include $(TOP)/extmod/extmod.mk
+
+INC += -I.
+INC += -I$(TOP)
+INC += -I$(BUILD)
+INC += -I$(VARIANT_DIR)
+
+# compiler settings
+# CIRCUITPY-CHANGE: the unix port's warnings and gnu11, less -Wfloat-conversion,
+# which MinGW's isnan(), isinf() and signbit() macros trip on doubles
+CFLAGS += $(INC) -Wall -Werror -Wextra -Wno-unused-parameter -Wpointer-arith -Wdouble-promotion -Wno-missing-field-initializers -std=gnu11 -DUNIX -D__USE_MINGW_ANSI_STDIO=1 $(COPT) $(CFLAGS_EXTRA)
+LDFLAGS += -lm -lbcrypt -lwinmm $(LDFLAGS_EXTRA)
+
+# Force the use of 64-bits for file sizes in C library functions on 32-bit platforms.
+# This option has no effect on 64-bit builds.
+CFLAGS += -D_FILE_OFFSET_BITS=64
+
+# Force the use of 64-bits for time_t in C library functions on 32-bit platforms.
+# This option has no effect on 64-bit builds.
+CFLAGS += -D_TIME_BITS=64
+
+# Debugging/Optimization
+ifdef DEBUG
+CFLAGS += -g
+# CIRCUITPY-CHANGE: -Og, as the unix port (its coverage variant sets DEBUG)
+COPT = -Og
+else
+COPT = -Os #-DNDEBUG
+endif
+
+# CIRCUITPY-CHANGE: drop unused code, as the unix port does. The coverage
+# variant's C++ check (coveragecpp.cpp) names functions nothing defines, and
+# leaves them for the linker to drop.
+COPT += -fdata-sections -ffunction-sections
+LDFLAGS += -Wl,--gc-sections
+
+# CIRCUITPY-CHANGE: CircuitPython builds with these.
+CFLAGS += -DCIRCUITPY=1
+
+# source files
+SRC_C += \
+	shared/libc/printf.c \
+	shared/runtime/gchelper_generic.c \
+	ports/unix/main.c \
+	ports/unix/input.c \
+	ports/unix/gccollect.c \
+	windows_mphal.c \
+	mod_timing.c \
+	realpath.c \
+	init.c \
+	fmode.c \
+	$(wildcard $(VARIANT_DIR)/*.c)
+
+# CIRCUITPY-CHANGE: what the unix port compiles beside its own files.
+SRC_C += \
+	shared-module/os/__init__.c \
+	supervisor/shared/settings.c \
+	supervisor/stub/filesystem.c \
+	supervisor/stub/safe_mode.c \
+	supervisor/stub/stack.c \
+	supervisor/shared/translate/translate.c \
+	$(SRC_MOD)
+
+ifeq ($(MICROPY_VFS_FAT),1)
+SRC_C += ports/unix/fatfs_port.c
+endif
+
+SRC_EXTMOD_C += extmod/modtime.c
+
+$(BUILD)/supervisor/shared/translate/translate.o: $(HEADER_BUILD)/qstrdefs.generated.h $(HEADER_BUILD)/compressed_translations.generated.h
+
+SHARED_SRC_C += $(addprefix shared/,\
+	runtime/pyexec.c \
+	timeutils/timeutils.c \
+	$(SHARED_SRC_C_EXTRA) \
+	)
+
+ifeq ($(MICROPY_USE_READLINE),1)
+INC += -I$(TOP)/shared/readline
+CFLAGS += -DMICROPY_USE_READLINE=1
+SHARED_SRC_C += shared/readline/readline.c
+endif
+
+LIBS += -lws2_32
+
+ifeq ($(MICROPY_PY_FFI),1)
+GIT_SUBMODULES += lib/libffi
+DEPLIBS += libffi
+QSTR_GLOBAL_REQUIREMENTS += $(DEPLIBS)
+LIBFFI_CFLAGS := -I$(shell ls -1d $(BUILD)/lib/libffi/include 2>/dev/null || echo $(BUILD)/lib/libffi/include)
+ifeq ($(MICROPY_FORCE_32BIT),1)
+LIBFFI_LDFLAGS = $(BUILD)/lib/libffi/out/lib32/libffi.a
+else
+LIBFFI_LDFLAGS = $(BUILD)/lib/libffi/out/lib/libffi.a
+endif
+CFLAGS += $(LIBFFI_CFLAGS) -DMICROPY_PY_FFI=1
+LDFLAGS += $(LIBFFI_LDFLAGS)
+SRC_C += ports/unix/modffi.c
+endif
+
+OBJ = $(PY_O) $(addprefix $(BUILD)/, $(SRC_C:.c=.o))
+OBJ += $(addprefix $(BUILD)/, $(SRC_CXX:.cpp=.o))
+OBJ += $(addprefix $(BUILD)/, $(SHARED_SRC_C:.c=.o))
+OBJ += $(addprefix $(BUILD)/, $(LIB_SRC_C:.c=.o))
+
+# List of sources for qstr extraction
+SRC_QSTR += $(SRC_C) $(SRC_CXX) $(SHARED_SRC_C)
+
+# CIRCUITPY-CHANGE: as the unix port
+ifneq ($(FROZEN_MANIFEST),)
+CFLAGS += -DMICROPY_QSTR_EXTRA_POOL=mp_qstr_frozen_const_pool
+CFLAGS += -DMICROPY_MODULE_FROZEN_MPY
+CFLAGS += -DMPZ_DIG_SIZE=16
+CFLAGS += -DMICROPY_MODULE_FROZEN_STR
+endif
+
+ifeq ($(shell $(CC) -dumpmachine),i686-w64-mingw32)
+# GCC disables the SSE instruction set by default on i366 targets and we have
+# to specify all three of these options to enable it.
+# https://gcc.gnu.org/onlinedocs/gcc/x86-Options.html (see -mfpmath=unit section)
+# Enabling the SSE instruction set is necessary to get correct rounding of floating points.
+# https://lemire.me/blog/2020/06/26/gcc-not-nearest
+CFLAGS += -msse -mfpmath=sse -march=pentium4
+endif
+
+CXXFLAGS += $(filter-out -std=gnu11,$(CFLAGS))
+
+ifneq ($(CROSS_COMPILE),)
+CROSS_COMPILE_HOST = --host=$(patsubst %-,%,$(CROSS_COMPILE))
+else
+CROSS_COMPILE_HOST =
+endif
+
+include $(TOP)/py/mkrules.mk
+
+.PHONY: test
+
+deplibs: $(DEPLIBS)
+
+libffi: $(BUILD)/lib/libffi/include/ffi.h
+
+$(TOP)/lib/libffi/configure: $(TOP)/lib/libffi/autogen.sh
+	cd $(TOP)/lib/libffi && ./autogen.sh
+
+$(BUILD)/lib/libffi/include/ffi.h: $(TOP)/lib/libffi/configure
+	mkdir -p $(BUILD)/lib/libffi && cd $(BUILD)/lib/libffi && \
+	$(abspath $(TOP))/lib/libffi/configure $(CROSS_COMPILE_HOST) --prefix=$$PWD/out --disable-shared --disable-structs CC="$(CC)" CXX="$(CXX)" LD="$(LD)" CFLAGS="-Os -fomit-frame-pointer -fstrict-aliasing -ffast-math -fno-exceptions" && \
+	$(MAKE) install-exec-recursive && $(MAKE) -C include install-data-am
+
+# Note for recent gcc versions like 13.2:
+# - mingw64-x86_64 gcc builds will pass the math_domain_special test
+# - mingw64-ucrt64 gcc builds will pass all of the below tests
+RUN_TESTS_SKIP += -e math_fun -e float2int_double -e float_parse -e math_domain_special
+
+test: $(BUILD)/$(PROG) $(TOP)/tests/run-tests.py
+	$(eval DIRNAME=ports/$(notdir $(CURDIR)))
+	cd $(TOP)/tests && MICROPY_MICROPYTHON=../$(DIRNAME)/$(BUILD)/$(PROG) $(PYTHON) ./run-tests.py $(RUN_TESTS_SKIP)
+
+$(BUILD)/$(PROG): $(BUILD)/micropython.res
+
+$(BUILD)/%.res: %.rc
+	$(ECHO) "WINDRES $<"
+	$(Q)$(WINDRES) $< -O coff -o $@
diff --git a/ports/windows/README.md b/ports/windows/README.md
new file mode 100644
index 0000000..d051e91
--- /dev/null
+++ b/ports/windows/README.md
@@ -0,0 +1,20 @@
+# CircuitPython's unix port, for Windows
+
+This builds `circuitpython.exe`: the unix port's interpreter, with its
+coverage variant's CircuitPython modules (`synthio`, `audiocore`,
+`audiomixer`, `ulab`, `jpegio` and the rest), as a native Windows program.
+It is MicroPython's windows port, which reuses the unix port's `main.c`,
+`input.c` and `gccollect.c`, with the CircuitPython pieces the unix port's
+Makefile adds.
+
+Build it from Linux with MinGW-w64:
+
+    sudo apt-get install gcc-mingw-w64-x86-64 autoconf automake libtool libltdl-dev
+    make -C ../../mpy-cross
+    make CROSS_COMPILE=x86_64-w64-mingw32-
+
+The program lands in `build-coverage/circuitpython.exe`. `ffi` is built from
+`lib/libffi`, and calls into Windows DLLs (`ffi.open("kernel32.dll")`).
+
+What the unix port has and this one doesn't: threads (`_thread`), `termios`,
+and the native code emitters.
