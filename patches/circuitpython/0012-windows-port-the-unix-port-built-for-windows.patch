+
+// CL specific overrides from mpconfig
+
+#define MP_NORETURN                 __declspec(noreturn)
+#define MP_WEAK
+#define MP_NOINLINE                 __declspec(noinline)
+#define MP_ALWAYSINLINE             __forceinline
+#define MP_LIKELY(x)                (x)
