+CFLAGS := $(filter-out -fprofile-arcs -ftest-coverage,$(CFLAGS))
+LDFLAGS := $(filter-out -fprofile-arcs -ftest-coverage,$(LDFLAGS))
+# The unix variant names its own port's files from the port directory.
+SRC_C := $(patsubst displayio_min.c,ports/unix/displayio_min.c,$(patsubst coverage.c,ports/unix/coverage.c,$(patsubst native_base_class.c,ports/unix/native_base_class.c,$(SRC_C))))
