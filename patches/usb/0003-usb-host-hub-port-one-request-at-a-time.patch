From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PyDevices <pydevices@users.noreply.github.com>
Date: Tue, 24 Nov 2026 12:00:00 -0600
Subject: [PATCH] usb_host: one request at a time on an external hub's port

An external hub has one control transfer, shared by the hub and all its
ports, and the port driver sent a second request on it while the first was
still in flight. The second submit overwrote the stage the first one's
completion is handled by, and that completion then reached
handle_device() in a stage it doesn't expect: abort().

It happens when a device behind the hub detaches and is freed quickly. The
connection change makes the port send ClearPortFeature(C_PORT_CONNECTION)
and wait for the device to be recycled. If the recycle arrives before the
clear has completed, handle_recycle() only waits for a status request, not
a feature request, so it handles the port again on the status it already
had and sends the same clear a second time. A device that drops off and
comes back several times within a few tens of milliseconds aborts the host.

The port driver now marks a port while its request is in flight, clears
the mark on that request's completion or when the hub is gone, and holds
the port's other actions until then. A request made while one is in flight
isn't sent; it marks the status as outdated instead, so the port reads its
status again and handles what the request was for. The hub driver refuses
a port request while its control transfer is busy rather than overwrite it.

---
diff --git a/src/ext_hub.c b/src/ext_hub.c
index ee3733d..bcb83bb 100644
--- a/src/ext_hub.c
+++ b/src/ext_hub.c
@@ -1855,6 +1855,14 @@ static esp_err_t ext_hub_control_request(ext_hub_dev_t *ext_hub_dev, uint8_t por
 {
     esp_err_t ret;
     usb_transfer_t *transfer = &ext_hub_dev->constant.ctrl_urb->transfer;
+    if (ext_hub_dev->single_thread.stage != EXT_HUB_STAGE_IDLE) {
+        // The hub's one control transfer is in use: submitting it again would
+        // overwrite the request in flight and the stage its completion is
+        // handled by.
+        ESP_LOGE(EXT_HUB_TAG, "Request %X, port %d, feature %d: control transfer busy (stage %s)",
+                 request, port1, feature, ext_hub_stage_strings[ext_hub_dev->single_thread.stage]);
+        return ESP_ERR_INVALID_STATE;
+    }
     switch (request) {
     case USB_B_REQUEST_HUB_GET_PORT_STATUS:
         USB_SETUP_PACKET_INIT_GET_PORT_STATUS((usb_setup_packet_t *)transfer->data_buffer, port1);
diff --git a/src/ext_port.c b/src/ext_port.c
index a5db0f8..f6c23ff 100644
--- a/src/ext_port.c
+++ b/src/ext_port.c
@@ -63,7 +63,8 @@ struct ext_port_s {
             uint32_t has_enum_device: 1;    /**< Port has an enumerated device */
             uint32_t waiting_recycle: 1;    /**< Port is waiting to be recycled */
             uint32_t waiting_free: 1;       /**< Port is waiting to be freed */
-            uint32_t reserved25: 25;        /**< Reserved */
+            uint32_t req_in_flight: 1;      /**< Port has a request on its parent's control pipe that hasn't completed */
+            uint32_t reserved24: 24;        /**< Reserved */
         };
         uint32_t val;                       /**< Ports' flags value */
     } flags;                                /**< Ports' flags */
@@ -229,6 +230,14 @@ static inline bool port_has_finished_reset(ext_port_t *ext_port)
  */
 static esp_err_t port_request_status(ext_port_t *ext_port)
 {
+    if (ext_port->flags.req_in_flight) {
+        // The parent hub has one control transfer for all its ports, and this
+        // port's last request on it hasn't completed. Re-read the status once
+        // it has: whatever this request was for still shows there.
+        ESP_LOGD(EXT_PORT_TAG, "Port%d request while another is in flight", ext_port->constant.port_num);
+        ext_port->flags.status_outdated = 1;
+        return ESP_ERR_INVALID_STATE;
+    }
     ext_port_parent_request_data_t data = {
         .type = EXT_PORT_PARENT_REQ_CONTROL,
         .control = {
@@ -242,6 +251,7 @@ static esp_err_t port_request_status(ext_port_t *ext_port)
     if (ret != ESP_OK) {
         return ret;
     }
+    ext_port->flags.req_in_flight = 1;
     // Port is requesting status, lock the status
     ext_port->flags.status_lock = 1;
     return ESP_OK;
@@ -263,6 +273,14 @@ static esp_err_t port_request_status(ext_port_t *ext_port)
  */
 static esp_err_t port_set_feature(ext_port_t *ext_port, const usb_hub_port_feature_t feature)
 {
+    if (ext_port->flags.req_in_flight) {
+        // The parent hub has one control transfer for all its ports, and this
+        // port's last request on it hasn't completed. Re-read the status once
+        // it has: whatever this request was for still shows there.
+        ESP_LOGD(EXT_PORT_TAG, "Port%d request while another is in flight", ext_port->constant.port_num);
+        ext_port->flags.status_outdated = 1;
+        return ESP_ERR_INVALID_STATE;
+    }
     ext_port_parent_request_data_t data = {
         .type = EXT_PORT_PARENT_REQ_CONTROL,
         .control = {
@@ -277,6 +295,7 @@ static esp_err_t port_set_feature(ext_port_t *ext_port, const usb_hub_port_featu
     if (ret != ESP_OK) {
         return ret;
     }
+    ext_port->flags.req_in_flight = 1;
     // Every set feature requires status update
     ext_port->flags.status_outdated = 1;
     switch (feature) {
@@ -310,6 +329,14 @@ static esp_err_t port_set_feature(ext_port_t *ext_port, const usb_hub_port_featu
  */
 static esp_err_t port_clear_feature(ext_port_t *ext_port, const usb_hub_port_feature_t feature)
 {
+    if (ext_port->flags.req_in_flight) {
+        // The parent hub has one control transfer for all its ports, and this
+        // port's last request on it hasn't completed. Re-read the status once
+        // it has: whatever this request was for still shows there.
+        ESP_LOGD(EXT_PORT_TAG, "Port%d request while another is in flight", ext_port->constant.port_num);
+        ext_port->flags.status_outdated = 1;
+        return ESP_ERR_INVALID_STATE;
+    }
     ext_port_parent_request_data_t data = {
         .type = EXT_PORT_PARENT_REQ_CONTROL,
         .control = {
@@ -324,6 +351,7 @@ static esp_err_t port_clear_feature(ext_port_t *ext_port, const usb_hub_port_fea
     if (ret != ESP_OK) {
         return ret;
     }
+    ext_port->flags.req_in_flight = 1;
     // Every clearing feature requires status update
     ext_port->flags.status_outdated = 1;
     return ret;
@@ -1101,6 +1129,8 @@ static esp_err_t port_gone(void *port_hdl)
 
     ext_port->flags.is_gone = 1;
     ext_port->flags.waiting_free = 1;
+    // The parent is gone: a request still in flight will never complete
+    ext_port->flags.req_in_flight = 0;
 
     switch (ext_port->state) {
     case USB_PORT_STATE_ENABLED:
@@ -1177,6 +1207,8 @@ static esp_err_t port_set_status(void *port_hdl, const usb_port_status_t *port_s
     // Update status
     ext_port->status.wPortChange.val = port_status->wPortChange.val;
     ext_port->status.wPortStatus.val = port_status->wPortStatus.val;
+    // The status request has completed
+    ext_port->flags.req_in_flight = 0;
     // Status valid
     ext_port->flags.status_outdated = 0;
     // Remove status lock
@@ -1203,6 +1235,8 @@ static esp_err_t port_req_process(void *port_hdl)
     EXT_PORT_CHECK(port_hdl != NULL, ESP_ERR_INVALID_ARG);
     ext_port_t *ext_port = (ext_port_t *)port_hdl;
 
+    // The feature request has completed
+    ext_port->flags.req_in_flight = 0;
     if (ext_port->flags.status_outdated) {
         port_set_actions(ext_port, PORT_ACTION_GET_STATUS);
     } else {
@@ -1286,22 +1320,39 @@ esp_err_t ext_port_process(void)
         return ESP_OK;
     }
 
+    if (ext_port->flags.req_in_flight) {
+        // The port's request on its parent hasn't completed. Its completion
+        // queues the port again, and the actions wait until then: a recycle
+        // or a disable handled now would act on a status the request is
+        // about to change, and send a second request on the parent's one
+        // control transfer while the first is still in flight.
+        return ESP_OK;
+    }
+
     uint32_t action_flags = ext_port->action_flags;
     ext_port->action_flags = 0;
 
-    while (action_flags) {
+    while (action_flags && !ext_port->flags.req_in_flight) {
         // Keep processing until all port's action have been handled
         ESP_LOGD(EXT_PORT_TAG, "Port%d actions 0x%"PRIx32"", ext_port->constant.port_num, action_flags);
 
+        // Each step can send a request to the parent; once one is in flight,
+        // the rest wait for its completion.
         if (action_flags & PORT_ACTION_HANDLE) {
+            action_flags &= ~PORT_ACTION_HANDLE;
             handle_port(ext_port);
         }
-        if (action_flags & PORT_ACTION_DISABLE) {
+        if ((action_flags & PORT_ACTION_DISABLE) && !ext_port->flags.req_in_flight) {
+            action_flags &= ~PORT_ACTION_DISABLE;
             handle_disable(ext_port);
         }
-        if (action_flags & PORT_ACTION_RECYCLE) {
+        if ((action_flags & PORT_ACTION_RECYCLE) && !ext_port->flags.req_in_flight) {
+            action_flags &= ~PORT_ACTION_RECYCLE;
             handle_recycle(ext_port);
         }
+        if (ext_port->flags.req_in_flight) {
+            break;
+        }
 
         /*
         * Feature related actions are mutual exclusive and require:
@@ -1325,10 +1376,13 @@ esp_err_t ext_port_process(void)
             }
             port_set_feature(ext_port, USB_FEATURE_PORT_RESET);
         }
+        action_flags &= ~(PORT_ACTION_GET_STATUS | PORT_ACTION_RESET);
 
-        action_flags = ext_port->action_flags;
+        action_flags |= ext_port->action_flags;
         ext_port->action_flags = 0;
     }
+    // Keep what waits for the request in flight, with anything queued meanwhile
+    ext_port->action_flags |= action_flags;
 
     return ESP_OK;
 }
