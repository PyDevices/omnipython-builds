+#if HCD_BUFFER_DMA
+/**
+ * @brief Start of (micro)frame in Buffer DMA mode: start the channels waiting for this (micro)frame
+ */
+static void bd_sof(port_t *port, bool *yield)
+{
+    usb_dwc_hal_context_t *hal = port->hal;
+    const uint32_t next = (bd_frnum(port) + 1) & 0x3FFF;
+    const bool hs = port->speed == USB_SPEED_HIGH;
+    const bool frame_start = !hs || (next & 7) == 0;
+    const uint32_t frame = hs ? (next >> 3) : next;
+    const uint32_t sched = frame_start ? ((uint32_t *)port->frame_list)[frame % FRAME_LIST_LEN] : 0;
+    uint32_t mask = port->bdma_wait_mask;
+    while (mask) {
+        int chan_idx = __builtin_ctz(mask);
+        mask &= mask - 1;
+        uint32_t bit = 1U << chan_idx;
+        usb_dwc_hal_chan_t *chan_obj = hal->channels.hdls[chan_idx];
+        pipe_t *pipe = (chan_obj != NULL) ? (pipe_t *)usb_dwc_hal_chan_get_context(chan_obj) : NULL;
+        if (!(port->bdma_wait_mask & bit)) {
+            continue;   // Started or ended while a callback ran
+        }
+        if (pipe == NULL || pipe->bdma.state != BD_STATE_WAIT || !chan_obj->flags.active) {
+            port->bdma_wait_mask &= ~bit;
+            continue;
+        }
+        usb_dwc_hal_chan_event_t chan_event = USB_DWC_HAL_CHAN_EVENT_NONE;
+        if (pipe->bdma.halt_req && !(pipe->tt_hub_addr != 0 && pipe->bdma.csplit
+                                     && pipe->ep_char.type != USB_DWC_XFER_TYPE_ISOCHRONOUS)) {
+            // (A bulk or control complete split waiting for its microframe collects its result first)
+            chan_event = bd_halt_point(pipe);
+        } else if (!port->flags.conn_dev_ena) {
+            continue;
+        } else {
+            switch (pipe->ep_char.type) {
+            case USB_DWC_XFER_TYPE_ISOCHRONOUS:
+                if (pipe->tt_hub_addr == 0) {
+                    chan_event = bd_isoc_slot(pipe, next);
+                } else if (pipe->bdma.at_set) {
+                    // A complete split waiting for its microframe. One whose frame went by is given up.
+                    uint32_t ahead = ((uint32_t)pipe->bdma.at - next) & 0x3FFF;
+                    if (ahead == 0) {
+                        bd_arm_uf(pipe, next);
+                    } else if (ahead > 8) {
+                        bd_qtd_writeback(pipe, bd_qtd(pipe), bd_qtd(pipe)->buffer_status_val & BD_QTD_SIZE_MASK,
+                                         USB_DWC_LL_QTD_STATUS_PKTERR);
+                        chan_event = bd_isoc_next(pipe);
+                    }
+                } else if ((next & 7) == pipe->tt_ss
+                           && (((uint32_t *)port->frame_list)[frame % FRAME_LIST_LEN] & bit)) {
+                    bd_arm_uf(pipe, next);   // The start split, in the microframe the pipe was given
+                }
+                break;
+            case USB_DWC_XFER_TYPE_INTR:
+                if (sched & bit) {
+                    bd_arm(pipe, next & 1);
+                }
+                break;
+            default:
