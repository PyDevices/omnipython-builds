From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PyDevices <pydevices@users.noreply.github.com>
Date: Sat, 21 Nov 2026 06:00:00 -0600
Subject: [PATCH] usb_host: full- and low-speed devices behind a high-speed
 hub, through its transaction translator

A full- or low-speed device behind a high-speed hub was refused. It is now
reached through the hub's transaction translator with split transactions.

The hub driver works out each device's translator (the high-speed hub's
address and port, inherited through full-speed hubs) and the USB host
library carries it into every pipe of the device. The HCD programs HCSPLT
for those pipes.

The DWC_OTG cannot issue split transactions in Scatter/Gather DMA mode:
a split control transfer completes its setup stage and then never
completes its data stage. With USB_HOST_DWC_SPLIT_TRANSACTIONS (on by
default on the ESP32-P4 and ESP32-S31) a high-speed host port therefore
runs in Buffer DMA mode. The HCD still fills and parses the same QTD lists;
a small engine executes them, one channel run per QTD (per packet for a
split), writes each QTD's status back as the DMA would, and reports the
same channel events. It handles the split handshakes (start split ACK,
complete split NYET, NAK restarts) and starts periodic channels from the
SOF interrupt following the frame list, since Buffer DMA mode has no
periodic scheduler.

Not done: Clear_TT_Buffer after a failed split to a translator's bulk or
control endpoint, isochronous OUT splits of more than 188 bytes
(multiple start splits), and the bandwidth budgeting of the translator's
full-speed frame.
---
diff --git a/Kconfig b/Kconfig
index d0bf947..325d70d 100644
--- a/Kconfig
+++ b/Kconfig
@@ -243,6 +243,19 @@ menu "USB-OTG"
             accessing external RAM.
         # Todo: IDF-11368 (aligned memory alloc size)
 
+    config USB_HOST_DWC_SPLIT_TRANSACTIONS
+        depends on IDF_TARGET_ESP32P4 || IDF_TARGET_ESP32S31
+        bool "Full- and low-speed devices behind a high-speed hub (split transactions)"
+        default y
+        help
+            A full- or low-speed device behind a high-speed hub is reached through the hub's transaction
+            translator, using split transactions. The USB-DWC can only issue split transactions in Buffer DMA
+            mode, so with this option the high-speed host port runs in Buffer DMA mode instead of Scatter/Gather
+            DMA mode. The driver then starts each transaction from its interrupt handler, and periodic transfers
+            from the start of frame interrupt, which costs more CPU time than Scatter/Gather DMA.
+
+            When disabled, a full- or low-speed device behind a high-speed hub is refused.
+
     # Hidden or compatibility options
     config USB_OTG_SUPPORTED
         # Invisible config kept for compatibility
diff --git a/private_include/ext_hub.h b/private_include/ext_hub.h
index aee4f6e..7d19b1b 100644
--- a/private_include/ext_hub.h
+++ b/private_include/ext_hub.h
@@ -106,6 +106,25 @@ esp_err_t ext_hub_get_speed(ext_hub_handle_t ext_hub_hdl, usb_speed_t *speed);
  */
 hcd_port_handle_t ext_hub_get_root_port(ext_hub_handle_t ext_hub_hdl);
 
+/**
+ * @brief Get the transaction translator that serves a device on one of an External Hub's ports
+ *
+ * A full- or low-speed device on a high-speed hub is reached through that hub's transaction translator. A device on
+ * a full-speed hub that is itself behind a high-speed hub shares the translator that serves the full-speed hub.
+ *
+ * @param[in] ext_hub_hdl External Hub device handle
+ * @param[in] port_num Port number (1-based)
+ * @param[in] port_speed Speed of the device on that port
+ * @param[out] tt_hub_addr Address of the high-speed hub whose transaction translator serves the device, 0 if none
+ * @param[out] tt_port_num That hub's port, 0 if none
+ *
+ * @return
+ *    - ESP_ERR_INVALID_ARG if a pointer is NULL
+ *    - ESP_ERR_NOT_FOUND if the hub is not found
+ *    - ESP_OK if the translator was obtained
+ */
+esp_err_t ext_hub_get_port_tt(ext_hub_handle_t ext_hub_hdl, uint8_t port_num, usb_speed_t port_speed, uint8_t *tt_hub_addr, uint8_t *tt_port_num);
+
 /**
  * @brief Add new device
  *
diff --git a/private_include/hcd.h b/private_include/hcd.h
index e8e3e1f..bcc7342 100644
--- a/private_include/hcd.h
+++ b/private_include/hcd.h
@@ -197,6 +197,8 @@ typedef struct {
     const usb_ep_desc_t *ep_desc;           /**< Pointer to endpoint descriptor of the pipe */
     usb_speed_t dev_speed;                  /**< Speed of the device */
     uint8_t dev_addr;                       /**< Device address of the pipe */
+    uint8_t tt_hub_addr;                    /**< Address of the high-speed hub whose transaction translator serves a full- or low-speed device, 0 if none */
+    uint8_t tt_port_num;                    /**< That hub's port the device is behind (1-based), 0 if none */
 } hcd_pipe_config_t;
 
 // ---------------------------------------------------- HCD Port -------------------------------------------------------
diff --git a/private_include/usbh.h b/private_include/usbh.h
index 6bf02c6..347a454 100644
--- a/private_include/usbh.h
+++ b/private_include/usbh.h
@@ -164,6 +164,8 @@ typedef struct {
     hcd_port_handle_t root_port_hdl;        /**< Handle of the port that the device is connected to */
     usb_device_handle_t parent_dev_hdl;     /**< Parent's device handle */
     uint8_t parent_port_num;                /**< Parent's port number */
+    uint8_t tt_hub_addr;                    /**< Address of the high-speed hub whose transaction translator serves this full- or low-speed device, 0 if none */
+    uint8_t tt_port_num;                    /**< That hub's port the device is behind (1-based), 0 if none */
 } usbh_dev_params_t;
 
 // ---------------------- USBH Processing Functions ----------------------------
@@ -445,6 +447,19 @@ esp_err_t usbh_dev_get_info(usb_device_handle_t dev_hdl, usb_device_info_t *dev_
  */
 esp_err_t usbh_dev_get_root_port_hdl(usb_device_handle_t dev_hdl, hcd_port_handle_t *root_port_hdl);
 
+/**
+ * @brief Get the transaction translator a full- or low-speed device is reached through
+ *
+ * @param[in] dev_hdl Device handle
+ * @param[out] tt_hub_addr Address of the high-speed hub whose transaction translator serves the device, 0 if none
+ * @param[out] tt_port_num That hub's port the device is behind, 0 if none
+ *
+ * @return
+ *    - ESP_OK: Transaction translator obtained successfully
+ *    - ESP_ERR_INVALID_ARG: Invalid argument
+ */
+esp_err_t usbh_dev_get_tt(usb_device_handle_t dev_hdl, uint8_t *tt_hub_addr, uint8_t *tt_port_num);
+
 /**
  * @brief Get a device's device descriptor
  *
diff --git a/src/ext_hub.c b/src/ext_hub.c
index e71116b..4b376f6 100644
--- a/src/ext_hub.c
+++ b/src/ext_hub.c
@@ -1331,6 +1331,27 @@ esp_err_t ext_hub_get_speed(ext_hub_handle_t ext_hub_hdl, usb_speed_t *speed)
     return ESP_OK;
 }
 
+esp_err_t ext_hub_get_port_tt(ext_hub_handle_t ext_hub_hdl, uint8_t port_num, usb_speed_t port_speed, uint8_t *tt_hub_addr, uint8_t *tt_port_num)
+{
+    EXT_HUB_CHECK(ext_hub_hdl != NULL && tt_hub_addr != NULL && tt_port_num != NULL, ESP_ERR_INVALID_ARG);
+    EXT_HUB_CHECK(dev_is_in_list(ext_hub_hdl), ESP_ERR_NOT_FOUND);
+    ext_hub_dev_t *ext_hub_dev = (ext_hub_dev_t *)ext_hub_hdl;
+    usb_device_info_t dev_info;
+    ESP_ERROR_CHECK(usbh_dev_get_info(ext_hub_dev->constant.dev_hdl, &dev_info));
+    *tt_hub_addr = 0;
+    *tt_port_num = 0;
+    if (dev_info.speed == USB_SPEED_HIGH) {
+        // A high-speed hub translates for the full- and low-speed devices on its own ports
+        if (port_speed != USB_SPEED_HIGH) {
+            *tt_hub_addr = ext_hub_dev->constant.dev_addr;
+            *tt_port_num = port_num;
+        }
+        return ESP_OK;
+    }
+    // A full-speed hub behind a high-speed one: its devices share the translator that serves the hub
+    return usbh_dev_get_tt(ext_hub_dev->constant.dev_hdl, tt_hub_addr, tt_port_num);
+}
+
 hcd_port_handle_t ext_hub_get_root_port(ext_hub_handle_t ext_hub_hdl)
 {
     EXT_HUB_CHECK(ext_hub_hdl != NULL, NULL);
diff --git a/src/hcd_dwc.c b/src/hcd_dwc.c
index 8dad6d8..8fd71b4 100644
--- a/src/hcd_dwc.c
+++ b/src/hcd_dwc.c
@@ -143,6 +143,12 @@ DEFINE_CRIT_SECTION_LOCK_STATIC(hcd_lock);
 #define CACHE_SYNC_DATA_BUFFER_C2M(pipe, urb)
 #endif // CACHED_MEMORY_SYNC
 
+#if CONFIG_USB_HOST_DWC_SPLIT_TRANSACTIONS
+#define HCD_BUFFER_DMA                              1
+#else
+#define HCD_BUFFER_DMA                              0
+#endif
+
 // ------------------------------------------------------ Types --------------------------------------------------------
 
 typedef struct pipe_obj pipe_t;
@@ -192,6 +198,36 @@ typedef struct {
     } status_flags;                         // Status flags for the buffer
 } dma_buffer_block_t;
 
+#if HCD_BUFFER_DMA
+typedef enum {
+    BD_STATE_IDLE,      // Not executing a buffer
+    BD_STATE_RUN,       // The channel is enabled
+    BD_STATE_WAIT,      // Waiting for a (micro)frame to start the channel in
+} bd_state_t;
+
+/**
+ * @brief Buffer DMA mode: where a pipe's channel is in executing its QTD list
+ */
+typedef struct {
+    void *list;                     // QTD list being executed
+    dma_buffer_block_t *buffer;     // Buffer the list belongs to
+    int len;                        // Length of the list
+    int idx;                        // Current QTD
+    int stop_idx;                   // QTD index reported when the buffer is done
+    int hoc_idx;                    // Isochronous: the last QTD of the buffer
+    int interval;                   // Isochronous: QTD spacing
+    uint32_t done;                  // Bytes of the current QTD moved so far
+    uint32_t run_len;               // Bytes the channel was started with
+    uint32_t run_pkts;              // Packets the channel was started with
+    uint8_t errors;                 // Consecutive transaction errors
+    uint8_t nyets;                  // Complete splits answered NYET
+    bd_state_t state;
+    uint8_t csplit: 1;              // The next run is a complete split
+    uint8_t ping: 1;                // The next OUT run starts with PING
+    uint8_t halt_req: 1;            // A halt was requested
+} bdma_t;
+#endif // HCD_BUFFER_DMA
+
 /**
  * @brief Object representing a pipe in the HCD layer
  */
@@ -220,6 +256,14 @@ struct pipe_obj {
     // HAL related
     usb_dwc_hal_chan_t *chan_obj;
     usb_dwc_hal_ep_char_t ep_char;
+    // Split transactions: the transaction translator a full- or low-speed device behind a high-speed hub is reached
+    // through. tt_hub_addr is 0 for a device the root port talks to at its own speed.
+    uint8_t tt_hub_addr;
+    uint8_t tt_port_num;
+    bool tt_ls;                             // Low-speed device behind the translator
+#if HCD_BUFFER_DMA
+    bdma_t bdma;                            // Buffer DMA mode execution state
+#endif
     // Port related
     port_t *port;                           // The port to which this pipe is routed through
     TAILQ_ENTRY(pipe_obj) tailq_entry;      // TailQ entry for port's list of pipes
@@ -279,6 +323,10 @@ struct port_obj {
     SemaphoreHandle_t port_mux;
     void *context;
     intr_handle_t isr_hdl;       // Interrupt handle for this root port (USB-OTG peripheral)
+#if HCD_BUFFER_DMA
+    bool bdma;                   // The port runs in Buffer DMA mode (split transactions)
+    uint32_t bdma_wait_mask;     // Channels waiting for a (micro)frame to start in
+#endif
 };
 
 // With s_port_inited[] we can check if a port has been initialized -> to provide singleton handle for each root port
@@ -909,6 +957,539 @@ static usb_speed_t get_usb_port_speed(usb_dwc_speed_t priv)
     }
 }
 
+// ------------------------------------------ Buffer DMA (split transactions) ------------------------------------------
+
+#if HCD_BUFFER_DMA
+/*
+The DWC_OTG executes split transactions only in Buffer DMA mode: in Scatter/Gather mode a channel programmed for splits
+completes its start split and then never finishes the transaction. With CONFIG_USB_HOST_DWC_SPLIT_TRANSACTIONS, a
+high-speed host port runs in Buffer DMA mode, and this engine executes the same QTD lists the rest of the HCD fills and
+parses: it programs one channel run per QTD (per packet for split transactions), writes each QTD's status back as the
+Scatter/Gather DMA would, and reports the same channel events. Periodic channels are started from the SOF interrupt
+according to the HAL's frame list, since Buffer DMA mode has no periodic scheduler.
+*/
+
+#define BD_HCCHAR_EPDIR         (1U << 15)
+#define BD_HCCHAR_EC_SHIFT      20
+#define BD_HCCHAR_EC_MASK       (3U << 20)
+#define BD_HCCHAR_ODDFRM        (1U << 29)
+#define BD_HCCHAR_CHDIS         (1U << 30)
+#define BD_HCCHAR_CHENA         (1U << 31)
+#define BD_HCSPLT_COMPSPLT      (1U << 16)
+#define BD_HCTSIZ_XFERSIZE_MASK 0x7FFFFU
+#define BD_HCTSIZ_PKTCNT_SHIFT  19
+#define BD_HCTSIZ_PKTCNT_MASK   0x3FFU
+#define BD_HCTSIZ_PID_SHIFT     29
+#define BD_HCTSIZ_PID_MASK      (3U << 29)
+#define BD_HCTSIZ_DOPNG         (1U << 31)
+#define BD_PID_DATA0            0U
+#define BD_PID_DATA2            1U
+#define BD_PID_DATA1            2U
+#define BD_PID_SETUP            3U
+
+#define BD_QTD_SIZE_MASK        0x1FFFFU
+#define BD_QTD_SETUP            (1U << 24)
+#define BD_QTD_IOC              (1U << 25)  // Set on the QTD that halts the channel (USB_DWC_HAL_XFER_DESC_FLAG_HOC)
+#define BD_QTD_STATUS_SHIFT     28
+#define BD_QTD_STATUS_MASK      (3U << 28)
+#define BD_QTD_ACTIVE           (1U << 31)
+
+#define BD_MAX_ERRORS           3   // Consecutive transaction errors before a transfer fails
+#define BD_MAX_CSPLIT_NYETS     6   // Periodic complete splits answered NYET before the (micro)frame is given up
+
+static inline bool bd_is_periodic(const pipe_t *pipe)
+{
+    return pipe->ep_char.type == USB_DWC_XFER_TYPE_INTR || pipe->ep_char.type == USB_DWC_XFER_TYPE_ISOCHRONOUS;
+}
+
+static inline bool bd_is_in(const pipe_t *pipe)
+{
+    return pipe->chan_obj->regs->hcchar_reg.val & BD_HCCHAR_EPDIR;
+}
+
+static inline uint32_t bd_frnum(const port_t *port)
+{
+    return usb_dwc_hal_port_get_cur_frame_num(port->hal) & 0x3FFF;
+}
+
+static inline usb_dwc_ll_dma_qtd_t *bd_qtd(pipe_t *pipe)
+{
+    return &((usb_dwc_ll_dma_qtd_t *)pipe->bdma.list)[pipe->bdma.idx];
+}
+
+static inline void bd_qtd_writeback(pipe_t *pipe, usb_dwc_ll_dma_qtd_t *qtd, uint32_t rem_len, uint32_t status)
+{
+    uint32_t val = qtd->buffer_status_val;
+    val &= ~(BD_QTD_SIZE_MASK | BD_QTD_STATUS_MASK | BD_QTD_ACTIVE);
+    val |= (rem_len & BD_QTD_SIZE_MASK) | (status << BD_QTD_STATUS_SHIFT);
+    qtd->buffer_status_val = val;
+    // The HCD reads the list from memory when it parses the buffer
+    CACHE_SYNC_XFER_DESCRIPTOR_LIST_C2M(pipe->bdma.buffer);
+}
+
+static inline void bd_wait(pipe_t *pipe)
+{
+    port_t *port = pipe->port;
+    pipe->bdma.state = BD_STATE_WAIT;
+    if (port->bdma_wait_mask == 0) {
+        usb_dwc_ll_gintsts_clear_intrs(port->hal->dev, USB_DWC_LL_INTR_CORE_SOF);
+        usb_dwc_ll_gintmsk_en_intrs(port->hal->dev, USB_DWC_LL_INTR_CORE_SOF);
+    }
+    port->bdma_wait_mask |= 1U << pipe->chan_obj->flags.chan_idx;
+}
+
+static inline void bd_unwait(pipe_t *pipe)
+{
+    port_t *port = pipe->port;
+    uint32_t bit = 1U << pipe->chan_obj->flags.chan_idx;
+    if (port->bdma_wait_mask & bit) {
+        port->bdma_wait_mask &= ~bit;
+        if (port->bdma_wait_mask == 0) {
+            usb_dwc_ll_gintmsk_dis_intrs(port->hal->dev, USB_DWC_LL_INTR_CORE_SOF);
+        }
+    }
+}
+
+/**
+ * @brief Start the channel on what is left of the current QTD
+ *
+ * @param odd For a periodic channel, start it in the next odd (rather than even) (micro)frame
+ */
+static void bd_arm(pipe_t *pipe, bool odd)
+{
+    bdma_t *bd = &pipe->bdma;
+    volatile usb_dwc_host_chan_regs_t *regs = pipe->chan_obj->regs;
+    usb_dwc_ll_dma_qtd_t *qtd = bd_qtd(pipe);
+    const uint32_t mps = pipe->ep_char.mps;
+    const bool is_in = bd_is_in(pipe);
+    const bool split = pipe->tt_hub_addr != 0;
+    const uint32_t size = qtd->buffer_status_val & BD_QTD_SIZE_MASK;
+    const uint32_t rem = size - bd->done;
+    uint32_t len;
+    uint32_t pkts;
+    if (pipe->ep_char.type == USB_DWC_XFER_TYPE_ISOCHRONOUS) {
+        // One (micro)frame's worth: up to three packets on a high-bandwidth high-speed endpoint
+        len = rem;
+        pkts = (len == 0) ? 1 : (len + mps - 1) / mps;
+    } else if (split || pipe->ep_char.type == USB_DWC_XFER_TYPE_INTR) {
+        // A split moves one packet, and an interrupt QTD is one packet in its own (micro)frame
+        len = (rem < mps) ? rem : mps;
+        pkts = 1;
+    } else {
+        len = rem;
+        pkts = (len == 0) ? 1 : (len + mps - 1) / mps;
+        if (pkts > BD_HCTSIZ_PKTCNT_MASK) {
+            pkts = BD_HCTSIZ_PKTCNT_MASK;
+            len = pkts * mps;
+        }
+    }
+    bd->run_len = len;
+    bd->run_pkts = pkts;
+
+    uint32_t pid = regs->hctsiz_reg.val & BD_HCTSIZ_PID_MASK;   // The data toggle the last run left
+    if (qtd->buffer_status_val & BD_QTD_SETUP) {
+        pid = BD_PID_SETUP << BD_HCTSIZ_PID_SHIFT;
+    } else if (pipe->ep_char.type == USB_DWC_XFER_TYPE_ISOCHRONOUS) {
+        uint32_t iso_pid = (is_in && pkts == 3) ? BD_PID_DATA2 : (is_in && pkts == 2) ? BD_PID_DATA1 : BD_PID_DATA0;
+        pid = iso_pid << BD_HCTSIZ_PID_SHIFT;
+    }
+    uint32_t hctsiz = (len & BD_HCTSIZ_XFERSIZE_MASK) | ((pkts & BD_HCTSIZ_PKTCNT_MASK) << BD_HCTSIZ_PKTCNT_SHIFT) | pid;
+    if (bd->ping && !is_in && !split) {
+        hctsiz |= BD_HCTSIZ_DOPNG;
+    }
+    regs->hctsiz_reg.val = hctsiz;
+    regs->hcdma_reg.val = (uint32_t)(qtd->buffer + bd->done);
+    if (split) {
+        uint32_t hcsplt = regs->hcsplt_reg.val & ~BD_HCSPLT_COMPSPLT;
+        if (bd->csplit) {
+            hcsplt |= BD_HCSPLT_COMPSPLT;
+        }
+        regs->hcsplt_reg.val = hcsplt;
+    }
+    uint32_t ec = (pipe->ep_char.type == USB_DWC_XFER_TYPE_ISOCHRONOUS) ? pkts : 1;
+    uint32_t hcchar = regs->hcchar_reg.val & ~(BD_HCCHAR_CHDIS | BD_HCCHAR_CHENA | BD_HCCHAR_ODDFRM | BD_HCCHAR_EC_MASK);
+    hcchar |= ec << BD_HCCHAR_EC_SHIFT;
+    if (bd_is_periodic(pipe) && odd) {
+        hcchar |= BD_HCCHAR_ODDFRM;
+    }
+    regs->hcchar_reg.val = hcchar | BD_HCCHAR_CHENA;
+    bd_unwait(pipe);
+    bd->state = BD_STATE_RUN;
+}
+
+/**
+ * @brief Start a periodic channel for the next (micro)frame
+ */
+static inline void bd_arm_next(pipe_t *pipe)
+{
+    bd_arm(pipe, (bd_frnum(pipe->port) + 1) & 1);
+}
+
+/**
+ * @brief Start the channel again on the current QTD: at once, or for a periodic channel or a throttled retry, from the
+ * SOF interrupt
+ */
+static inline void bd_retry(pipe_t *pipe, bool now)
+{
+    if (now) {
+        if (bd_is_periodic(pipe)) {
+            bd_arm_next(pipe);
+        } else {
+            bd_arm(pipe, false);
+        }
+    } else {
+        bd_wait(pipe);
+    }
+}
+
+static usb_dwc_hal_chan_event_t bd_end(pipe_t *pipe, usb_dwc_hal_chan_event_t event, int stop_idx)
+{
+    bdma_t *bd = &pipe->bdma;
+    bd_unwait(pipe);
+    bd->state = BD_STATE_IDLE;
+    bd->halt_req = 0;
+    bd->stop_idx = stop_idx;
+    pipe->chan_obj->flags.active = 0;
+    return event;
+}
+
+static inline usb_dwc_hal_chan_event_t bd_error(pipe_t *pipe, usb_dwc_hal_chan_error_t error)
+{
+    pipe->chan_obj->error = error;
+    return bd_end(pipe, USB_DWC_HAL_CHAN_EVENT_ERROR, pipe->bdma.idx);
+}
+
+/**
+ * @brief The current QTD has moved all it will move: write its status back, then go on to the next QTD or complete
+ */
+static usb_dwc_hal_chan_event_t bd_qtd_done(pipe_t *pipe, bool short_in)
+{
+    bdma_t *bd = &pipe->bdma;
+    usb_dwc_ll_dma_qtd_t *qtd = bd_qtd(pipe);
+    uint32_t size = qtd->buffer_status_val & BD_QTD_SIZE_MASK;
+    bool halt = (qtd->buffer_status_val & BD_QTD_IOC) || short_in;
+    bd_qtd_writeback(pipe, qtd, size - bd->done, USB_DWC_LL_QTD_STATUS_SUCCESS);
+    bd->done = 0;
+    bd->ping = 0;
+    int next = bd->idx + 1;
+    if (halt || next >= bd->len) {
+        // As in Scatter/Gather mode, the reported QTD index is the one after the QTD that halted the channel
+        return bd_end(pipe, USB_DWC_HAL_CHAN_EVENT_CPLT, next % bd->len);
+    }
+    bd->idx = next;
+    bd_retry(pipe, !bd_is_periodic(pipe));  // An interrupt QTD waits for its own (micro)frame
+    return USB_DWC_HAL_CHAN_EVENT_NONE;
+}
+
+/**
+ * @brief Isochronous: the QTD for this (micro)frame is done, or was missed. Go on to the next scheduled one.
+ */
+static usb_dwc_hal_chan_event_t bd_isoc_next(pipe_t *pipe)
+{
+    bdma_t *bd = &pipe->bdma;
+    if (bd->idx == bd->hoc_idx) {
+        return bd_end(pipe, USB_DWC_HAL_CHAN_EVENT_CPLT, bd->idx);
+    }
+    bd->idx = (bd->idx + bd->interval) % bd->len;
+    bd->done = 0;
+    bd_wait(pipe);
+    return USB_DWC_HAL_CHAN_EVENT_NONE;
+}
+
+/**
+ * @brief Isochronous: start the channel if the next (micro)frame is the current QTD's, skipping any QTD whose
+ * (micro)frame has already gone by
+ *
+ * @return USB_DWC_HAL_CHAN_EVENT_CPLT if the last QTD was skipped, else USB_DWC_HAL_CHAN_EVENT_NONE
+ */
+static usb_dwc_hal_chan_event_t bd_isoc_slot(pipe_t *pipe, uint32_t next_slot)
+{
+    next_slot &= XFER_LIST_LEN_ISOC - 1;
+    bdma_t *bd = &pipe->bdma;
+    for (int guard = 0; guard < XFER_LIST_LEN_ISOC; guard++) {
+        uint32_t ahead = ((uint32_t)bd->idx - next_slot) & (XFER_LIST_LEN_ISOC - 1);
+        if (ahead == 0) {
+            if (bd_qtd(pipe)->buffer_status_val & BD_QTD_ACTIVE) {
+                bd_arm(pipe, next_slot & 1);
+                return USB_DWC_HAL_CHAN_EVENT_NONE;
+            }
+        } else if (ahead < XFER_LIST_LEN_ISOC / 2) {
+            return USB_DWC_HAL_CHAN_EVENT_NONE;    // Its (micro)frame is still to come
+        }
+        // Missed: the QTD stays active, which the HCD parses as not executed
+        if (bd->idx == bd->hoc_idx) {
+            return bd_end(pipe, USB_DWC_HAL_CHAN_EVENT_CPLT, bd->idx);
+        }
+        bd->idx = (bd->idx + bd->interval) % bd->len;
+    }
+    return USB_DWC_HAL_CHAN_EVENT_NONE;
+}
+
+static void bd_activate(pipe_t *pipe, void *xfer_desc_list, int desc_list_len, int start_idx)
+{
+    bdma_t *bd = &pipe->bdma;
+    usb_dwc_hal_chan_t *chan_obj = pipe->chan_obj;
+    assert(!chan_obj->flags.active);
+    bd->list = xfer_desc_list;
+    bd->buffer = pipe->buffers[pipe->multi_buffer_control.rd_idx];
+    bd->len = desc_list_len;
+    bd->idx = start_idx;
+    bd->done = 0;
+    bd->errors = 0;
+    bd->nyets = 0;
+    bd->csplit = 0;
+    bd->ping = 0;
+    bd->halt_req = 0;
+    chan_obj->flags.active = 1;
+    usb_dwc_ll_hctsiz_set_dopng(chan_obj->regs, false);
+    switch (pipe->ep_char.type) {
+    case USB_DWC_XFER_TYPE_ISOCHRONOUS: {
+        int interval = pipe->ep_char.periodic.interval;
+        bd->interval = (interval > XFER_LIST_LEN_ISOC) ? XFER_LIST_LEN_ISOC : (interval < 1 ? 1 : interval);
+        // The last filled QTD, found by walking the schedule from the first
+        int idx = start_idx;
+        bd->hoc_idx = start_idx;
+        for (int i = 0; i < XFER_LIST_LEN_ISOC; i++) {
+            usb_dwc_ll_dma_qtd_t *qtd = &((usb_dwc_ll_dma_qtd_t *)xfer_desc_list)[idx];
+            if (!(qtd->buffer_status_val & BD_QTD_ACTIVE)) {
+                break;
+            }
+            bd->hoc_idx = idx;
+            if (qtd->buffer_status_val & BD_QTD_IOC) {
+                break;
+            }
+            idx = (idx + bd->interval) % XFER_LIST_LEN_ISOC;
+        }
+        // A buffer that follows on from the last one starts in the very next (micro)frame: waiting for the SOF
+        // interrupt would miss it
+        if (pipe->tt_hub_addr == 0
+                && (((uint32_t)start_idx - bd_frnum(pipe->port) - 1) & (XFER_LIST_LEN_ISOC - 1)) == 0) {
+            bd_arm_next(pipe);
+        } else {
+            bd_wait(pipe);
+        }
+        break;
+    }
+    case USB_DWC_XFER_TYPE_INTR:
+        bd_wait(pipe);
+        break;
+    default:
+        bd_arm(pipe, false);
+        break;
+    }
+}
+
+static bool bd_request_halt(pipe_t *pipe)
+{
+    bdma_t *bd = &pipe->bdma;
+    usb_dwc_hal_chan_t *chan_obj = pipe->chan_obj;
+    if (!chan_obj->flags.active) {
+        return true;
+    }
+    if (bd->state == BD_STATE_RUN) {
+        // The channel halted interrupt reports the halt
+        usb_dwc_ll_hcchar_disable_chan(chan_obj->regs);
+        bd->halt_req = 1;
+        return false;
+    }
+    // Waiting for its (micro)frame: nothing is on the bus. The next SOF interrupt reports the halt.
+    bd->halt_req = 1;
+    return false;
+}
+
+/**
+ * @brief The pipe is being marked halted without a halt request (its port is gone): forget its schedule
+ */
+static void bd_mark_halted(pipe_t *pipe)
+{
+    if (pipe->bdma.state != BD_STATE_IDLE || pipe->chan_obj->flags.active) {
+        bd_end(pipe, USB_DWC_HAL_CHAN_EVENT_NONE, pipe->bdma.idx);
+    }
+}
+
+/**
+ * @brief A channel interrupt in Buffer DMA mode: only the channel halted interrupt is unmasked, and HCINT says why
+ */
+static usb_dwc_hal_chan_event_t bd_decode_intr(pipe_t *pipe)
+{
+    bdma_t *bd = &pipe->bdma;
+    volatile usb_dwc_host_chan_regs_t *regs = pipe->chan_obj->regs;
+    uint32_t hcint = usb_dwc_ll_hcint_read_and_clear_intrs(regs);
+    if (!(hcint & USB_DWC_LL_INTR_CHAN_CHHLTD) || bd->state != BD_STATE_RUN) {
+        return USB_DWC_HAL_CHAN_EVENT_NONE;
+    }
+    bd->state = BD_STATE_IDLE;
+    if (bd->halt_req) {
+        bd->halt_req = 0;
+        return bd_end(pipe, USB_DWC_HAL_CHAN_EVENT_HALT_REQ, bd->idx);
+    }
+    const bool is_in = bd_is_in(pipe);
+    const bool periodic = bd_is_periodic(pipe);
+    const bool split = pipe->tt_hub_addr != 0;
+    const uint32_t mps = pipe->ep_char.mps;
+    const uint32_t hctsiz = regs->hctsiz_reg.val;
+    const uint32_t left_bytes = hctsiz & BD_HCTSIZ_XFERSIZE_MASK;
+    const uint32_t left_pkts = (hctsiz >> BD_HCTSIZ_PKTCNT_SHIFT) & BD_HCTSIZ_PKTCNT_MASK;
+    uint32_t moved;
+    if (is_in) {
+        moved = bd->run_len - left_bytes;
+    } else {
+        moved = (bd->run_pkts - left_pkts) * mps;
+        if (moved > bd->run_len) {
+            moved = bd->run_len;
+        }
+    }
+
+    if (hcint & USB_DWC_LL_INTR_CHAN_STALL) {
+        return bd_error(pipe, USB_DWC_HAL_CHAN_ERROR_STALL);
+    }
+    if (hcint & USB_DWC_LL_INTR_CHAN_BBLEER) {
+        return bd_error(pipe, USB_DWC_HAL_CHAN_ERROR_PKT_BBL);
+    }
+    if (hcint & USB_DWC_LL_INTR_CHAN_AHBERR) {
+        return bd_error(pipe, USB_DWC_HAL_CHAN_ERROR_XCS_XACT);
+    }
+
+    if (pipe->ep_char.type == USB_DWC_XFER_TYPE_ISOCHRONOUS) {
+        // One try per (micro)frame: a failed packet is reported in its QTD, not retried
+        usb_dwc_ll_dma_qtd_t *qtd = bd_qtd(pipe);
+        bool ok = hcint & USB_DWC_LL_INTR_CHAN_XFERCOMPL;
+        uint32_t size = qtd->buffer_status_val & BD_QTD_SIZE_MASK;
+        bd_qtd_writeback(pipe, qtd, ok ? size - moved : size, ok ? USB_DWC_LL_QTD_STATUS_SUCCESS : USB_DWC_LL_QTD_STATUS_PKTERR);
+        usb_dwc_hal_chan_event_t event = bd_isoc_next(pipe);
+        if (event == USB_DWC_HAL_CHAN_EVENT_NONE && !split) {
+            event = bd_isoc_slot(pipe, (bd_frnum(pipe->port) + 1) & 0x3FFF);
+        }
+        return event;
+    }
+
+    if (hcint & (USB_DWC_LL_INTR_CHAN_XACTERR | USB_DWC_LL_INTR_CHAN_DATATGLERR | USB_DWC_LL_INTR_CHAN_FRMOVRUN)) {
+        if ((hcint & USB_DWC_LL_INTR_CHAN_XACTERR) && ++bd->errors >= BD_MAX_ERRORS) {
+            return bd_error(pipe, USB_DWC_HAL_CHAN_ERROR_XCS_XACT);
+        }
+        if (!split) {
+            bd->done += moved;
+        }
+        // A split starts the packet over with a start split
+        bd->csplit = 0;
+        bd->nyets = 0;
+        bd_retry(pipe, !periodic);
+        return USB_DWC_HAL_CHAN_EVENT_NONE;
+    }
+
+    if (split) {
+        if (!bd->csplit) {
+            if (hcint & USB_DWC_LL_INTR_CHAN_ACK) {
+                // The translator took the start split: ask for the result
+                bd->csplit = 1;
+                bd->errors = 0;
+                bd_retry(pipe, true);
+            } else {
+                // NAK (or NYET): the translator's buffer is busy. Try again in the next frame.
+                bd_retry(pipe, false);
+            }
+            return USB_DWC_HAL_CHAN_EVENT_NONE;
+        }
+        if (hcint & USB_DWC_LL_INTR_CHAN_NYET) {
+            // Not yet: the full-speed transaction is still on its way
+            if (periodic && ++bd->nyets > BD_MAX_CSPLIT_NYETS) {
+                bd->csplit = 0;
+                bd->nyets = 0;
+                bd_retry(pipe, false);
+            } else {
+                bd_retry(pipe, true);
+            }
+            return USB_DWC_HAL_CHAN_EVENT_NONE;
+        }
+        if ((hcint & USB_DWC_LL_INTR_CHAN_NAK) && !(hcint & USB_DWC_LL_INTR_CHAN_XFERCOMPL)) {
+            // The device NAKed: start over in the next frame (the next interval for a periodic endpoint)
+            bd->csplit = 0;
+            bd->nyets = 0;
+            bd_retry(pipe, false);
+            return USB_DWC_HAL_CHAN_EVENT_NONE;
+        }
+        if (hcint & (USB_DWC_LL_INTR_CHAN_XFERCOMPL | USB_DWC_LL_INTR_CHAN_ACK)) {
+            bd->csplit = 0;
+            bd->nyets = 0;
+            bd->errors = 0;
+            bd->done += is_in ? moved : bd->run_len;
+            bool short_in = is_in && moved < mps;
+            uint32_t size = bd_qtd(pipe)->buffer_status_val & BD_QTD_SIZE_MASK;
+            if (!short_in && bd->done < size) {
+                bd_retry(pipe, !periodic);  // Next packet of this QTD
+                return USB_DWC_HAL_CHAN_EVENT_NONE;
+            }
+            return bd_qtd_done(pipe, short_in);
+        }
+        bd->csplit = 0;
+        bd_retry(pipe, false);
+        return USB_DWC_HAL_CHAN_EVENT_NONE;
+    }
+
+    if (hcint & USB_DWC_LL_INTR_CHAN_XFERCOMPL) {
+        bd->errors = 0;
+        bd->done += moved;
+        bool short_in = is_in && moved < bd->run_len;
+        uint32_t size = bd_qtd(pipe)->buffer_status_val & BD_QTD_SIZE_MASK;
+        if (!short_in && bd->done < size) {
+            bd_retry(pipe, !periodic);  // More than one run's worth of packets
+            return USB_DWC_HAL_CHAN_EVENT_NONE;
+        }
+        return bd_qtd_done(pipe, short_in);
+    }
+    // Halted part way: NAK on a periodic IN (no data this interval), NYET on a high-speed OUT (go on with PING)
+    bd->done += moved;
+    if ((hcint & USB_DWC_LL_INTR_CHAN_NYET) && !is_in) {
+        bd->ping = 1;
+    }
+    bd_retry(pipe, !periodic);
+    return USB_DWC_HAL_CHAN_EVENT_NONE;
+}
+#endif // HCD_BUFFER_DMA
