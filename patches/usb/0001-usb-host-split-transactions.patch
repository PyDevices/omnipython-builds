+        int chan_idx = __builtin_ctz(mask);
+        mask &= mask - 1;
+        uint32_t bit = 1U << chan_idx;
+        usb_dwc_hal_chan_t *chan_obj = hal->channels.hdls[chan_idx];
+        pipe_t *pipe = (chan_obj != NULL) ? (pipe_t *)usb_dwc_hal_chan_get_context(chan_obj) : NULL;
+        if (!(port->bdma_wait_mask & bit)) {
+            continue;   // Started or ended while a callback ran
+        }
+        if (pipe == NULL || pipe->bdma.state != BD_STATE_WAIT || !chan_obj->flags.active) {
+            port->bdma_wait_mask &= ~bit;
+            continue;
+        }
+        usb_dwc_hal_chan_event_t chan_event = USB_DWC_HAL_CHAN_EVENT_NONE;
+        if (pipe->bdma.halt_req) {
